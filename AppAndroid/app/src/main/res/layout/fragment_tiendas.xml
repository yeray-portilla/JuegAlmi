<?xml version="1.0" encoding="utf-8"?>
<!-- Layout comun de las pantallas Historia, Ubicacion y Galeria (TiendasBaseFragment).
     Arriba: titulo y boton recargar. Abajo, solo uno visible a la vez: cargando, error o la lista de tiendas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_titulo_tiendas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiendas"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btn_recargar_tiendas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tiendas_recargar"
            android:src="@drawable/ic_refresh"/>
    </LinearLayout>

    <!-- Estado "cargando" -->
    <ProgressBar
        android:id="@+id/pb_tiendas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"/>

    <!-- Estado "error": mensaje y boton Reintentar -->
    <LinearLayout
        android:id="@+id/ll_error_tiendas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error_tiendas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/estado_rechazada"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reintentar_tiendas"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tiendas_reintentar"
            android:textColor="@color/primary"
            android:textAllCaps="false"
            app:strokeColor="@color/primary"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <!-- Lista de tiendas: el Fragment mete aqui una tarjeta (item_tienda.xml) por tienda -->
    <ScrollView
        android:id="@+id/sv_tiendas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ll_lista_tiendas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/lista_aparecer"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp"/>
    </ScrollView>

</LinearLayout>
