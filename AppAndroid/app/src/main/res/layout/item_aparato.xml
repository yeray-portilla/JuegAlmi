<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un aparato del usuario (Soporte -> Mis aparatos), con boton para pedir su reparacion -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_nombre_aparato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Samsung Galaxy S21"/>

        <TextView
            android:id="@+id/tv_tipo_aparato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Móviles"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reparar_aparato"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pedir reparación"
            android:textColor="#FF8A6B"
            app:strokeColor="@color/primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:paddingVertical="8dp"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
