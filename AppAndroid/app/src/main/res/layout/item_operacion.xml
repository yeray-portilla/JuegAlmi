<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_foto_operacion"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="12dp"
            android:background="@color/surface_image_bg"
            android:contentDescription="Foto"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_titulo_operacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Alquiler #3"/>

        <TextView
            android:id="@+id/tv_detalle_operacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="The Legend of Zelda, Mario Kart x2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_fecha_operacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Desde el 2026-11-10 · "/>

            <TextView
                android:id="@+id/tv_estado_operacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Activo"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_motivo_operacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/estado_rechazada"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Motivo: no hay recambios"/>

        <TextView
            android:id="@+id/tv_total_operacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/price_yellow"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="15 €"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_accion_operacion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF8A6B"
            app:strokeColor="@color/primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:paddingVertical="8dp"
            app:cornerRadius="12dp"
            android:visibility="gone"
            tools:text="Devolver"
            tools:visibility="visible"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
